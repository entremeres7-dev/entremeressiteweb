{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "ios": {
        "distribution": "store",
        "buildConfiguration": "Release",
        "resourceClass": "m-medium",
        "credentialsSource": "remote",
        "cache": {
          "key": "ios-build-34-$(hash app.json)"
        }
      },
      "android": {
        "distribution": "store",
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "contact@entremeres.fr",
        "ascAppId": "auto",
        "appleTeamId": "auto"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  },
  "hooks": {
    "postPublish": [
      {
        "file": "sentry-expo/upload-sourcemaps",
        "config": {
          "organization": "entremeres",
          "project": "entremeres-app"
        }
      }
    ]
  }
} 