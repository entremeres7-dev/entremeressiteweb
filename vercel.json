{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"Site statique — pas de npm install\"",
  "buildCommand": "node website/scripts/generate-config.js",
  "outputDirectory": "website",
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/app/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
